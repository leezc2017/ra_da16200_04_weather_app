# ============================================================================
# 行尾与编码约定（重要：本工程有 GBK 文件）
#
# 背景：工具链按系统代码页(GBK)读源文件，所以部分文件必须是 GBK 无 BOM。
# 如果 git 做 CRLF 转换，GBK 文件的字节可能被改动，汉字变乱码。
# 因此：
#   - 二进制性质(GBK 源文件) -> 标 binary，git 完全不碰字节
#   - ASCII/UTF-8 文本       -> 标 text eol=lf，工作区保持 LF
# ============================================================================

# ---- GBK 无 BOM 源文件：git 不得改动任何字节 ----
*.c    text eol=lf
*.h    text eol=lf

# ---- 这些是 GBK 无 BOM（含中文注释/字库），按二进制处理 ----
src/oled/oledfont.h      binary
src/oled/oled_font_data.c binary
src/weather_text.c       binary
src/weather_text.h       binary

# ---- 明确声明 UTF-8 的文件 ----
src/hal_entry.c          text eol=lf
src/at_engine.c          text eol=lf
src/at_engine.h          text eol=lf
src/at_probe.c           text eol=lf
src/at_probe.h           text eol=lf
src/oled_port.c          text eol=lf
src/oled_port.h          text eol=lf
src/oled/oled_font.c     text eol=lf
src/oled/oled_font.h     text eol=lf
src/oled/oled.c          text eol=lf
src/oled/oled.h          text eol=lf
src/gpio_spi/*           text eol=lf
src/bsp_hal/*            text eol=lf
src/weather_ui.c         text eol=lf
src/weather_ui.h         text eol=lf
src/weather_parse.c      text eol=lf
src/weather_parse.h      text eol=lf
src/wifi_status.h        text eol=lf
src/weather_cfg.h        text eol=lf
src/oled_font_data/*.c   text eol=lf
tools/*.py               text eol=lf

# ---- 文档 ----
*.md        text eol=lf
.gitignore  text eol=lf

# ---- e2studio / FSP 工程文件：保持原样(e2studio 自己管行尾) ----
.cproject       text eol=lf
.project        text eol=lf
configuration.xml text eol=lf

# ---- 默认 ----
* text=auto